params {
    input  = "test_data/samplesheet.csv"
    outdir = "results"
    
    genome       = "test_data/references/Homo_sapiens_assembly38.chr21.fa"
    known_sites  = "test_data/references/dbsnp_146.hg38.chr21.vcf.gz"
    mills        = "test_data/references/Mills_and_1000G_gold_standard.indels.hg38.chr21.vcf.gz"
    
    interval     = "chr21"
    publish_dir_mode = "copy"
    
    gatk_container = "broadinstitute/gatk:4.5.0.0"
    
    max_memory = '16.GB'
    max_cpus   = 8
    max_time   = '24.h'
}

profiles {
    standard {
        process.executor = 'local'
        includeConfig 'conf/base.config'
    }
    docker {
        docker.enabled = true
        includeConfig 'conf/docker.config'
    }
    slurm {
        process.executor = 'slurm'
        includeConfig 'conf/slurm.config'
    }
    aws_batch {
        process.executor = 'awsbatch'
        includeConfig 'conf/aws_batch.config'
    }
    test {
        params.max_memory = '4.GB'
        params.max_cpus   = 2
    }
}
