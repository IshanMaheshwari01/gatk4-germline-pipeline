process {
    cpus   = { 1 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 2.h * task.attempt }

    // Requests are capped at params.max_* (Nextflow 24.04+). Replaces the old
    // check_max() helper, which Nextflow 26's strict config parser rejects.
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory as MemoryUnit,
        time:   params.max_time as Duration
    ]

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    withName: 'GATK_HAPLOTYPECALLER' {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
}
